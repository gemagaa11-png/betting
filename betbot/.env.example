# Salin file ini jadi .env (jangan dicommit ke GitHub!)
# Atau masukkan langsung ke Railway/Render sebagai environment variables

# WAJIB: Token bot dari @BotFather
BOT_TOKEN=your_bot_token_here

# OPSIONAL: ID admin (pisah koma jika lebih dari satu)
# Dapatkan ID kamu via @userinfobot di Telegram
ADMIN_IDS=123456789,987654321

# OPSIONAL: Path file database (default: data/users.json)
DATA_FILE=data/users.json
